CREATE TABLE IF NOT EXISTS song(
    path TEXT PRIMARY KEY NOT NULL,
    title TEXT NOT NULL,
    album TEXT,
    artist TEXT NOT NULL,
    duration INTEGER,
    artwork BLOB,
    state TEXT,
    -- Chromaprint's raw fingerprint, 4 bytes per value
    fingerprint BLOB
);

selectAll:
SELECT * FROM song;

selectAllSongs:
SELECT path, title, artist, album, duration, state FROM song;

selectPathStates:
SELECT path, state FROM song;

selectAllArtists:
SELECT DISTINCT artist FROM song;

selectAllAlbums:
SELECT DISTINCT album FROM song;

selectByPath:
SELECT * FROM song WHERE path = ?;

selectByNotState:
SELECT * FROM song WHERE state != ?;

selectArtworkByPath:
SELECT artwork FROM song WHERE path = ?;

getOrNull:
SELECT * FROM song WHERE path = ? LIMIT 1;

insert:
INSERT INTO song(title, album, artist, path, duration, state, artwork) VALUES(?, ?, ?, ?, ?, ?, ?);

insertOrIgnore:
INSERT OR IGNORE INTO song(title, album, artist, path, duration, state, artwork) VALUES(?, ?, ?, ?, ?, ?, ?);

update:
UPDATE song SET title = ?, album = ?, artist = ?, duration = ?, state = ?, artwork = ? WHERE path = ?;

-- playlist_song follows through ON UPDATE CASCADE
updatePath:
UPDATE song SET path = :newPath WHERE path = :oldPath;

updateState:
UPDATE song SET state = :state WHERE path = :path;

deleteByPath:
DELETE FROM song WHERE path = ?;

selectPathsWithoutFingerprint:
SELECT path FROM song WHERE fingerprint IS NULL AND (state IS NULL OR state != 'NotDownloaded');

selectFingerprint:
SELECT fingerprint FROM song WHERE path = ?;

selectFingerprints:
SELECT path, fingerprint FROM song WHERE fingerprint IS NOT NULL;

updateFingerprint:
UPDATE song SET fingerprint = :fingerprint WHERE path = :path;

search:
SELECT path, title, artist, album, duration, state FROM song
WHERE title LIKE '%' || :query || '%' OR artist LIKE '%' || :query || '%' OR album LIKE '%' || :query || '%';
